---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "PilotAI",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, PWA, Telegram",
  "description": "SaaS de gestion de projet avec IA souveraine, ingestion de réunions et pilotage vocal. Vos données restent en Europe.",
  "offers": {
    "@type": "Offer",
    "price": "Sur devis",
    "priceCurrency": "EUR"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Alliance Digitale"
  }
};
---

<Layout
  title="PilotAI — Gestion de projet avec IA souveraine"
  description="PilotAI : le logiciel de gestion de projet qui combine IA souveraine (modèle local), ingestion des réunions Notta et pilotage vocal. Vos données restent en Europe. Lancement octobre 2026."
  jsonLd={jsonLd}
>
  <Header />

  <main class="flex-1">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-alliance-dark-2 pt-24 pb-20 px-4 sm:px-6 lg:px-8">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-alliance-blue/10 via-transparent to-transparent"></div>
      <div class="relative max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-alliance-blue/30 bg-alliance-blue/10 text-alliance-blue text-xs font-semibold uppercase tracking-wider mb-6" data-hero-anim="badge">
              <span class="w-2 h-2 rounded-full bg-alliance-blue animate-pulse"></span>
              Lancement octobre 2026
            </div>

            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" data-hero-anim="title">
              <span class="hero-line">Gérez vos projets avec une IA</span><br class="hidden sm:block">
              <span class="gradient-text hero-line">qui reste chez vous</span>
            </h1>

            <p class="text-lg sm:text-xl text-white/70 max-w-2xl mb-10 leading-relaxed" data-hero-anim="lead">
              PilotAI combine IA souveraine, ingestion de réunions et pilotage vocal.
              Vos données restent en Europe. L'IA tourne sur votre serveur par défaut. Aucune fuite.
            </p>

            <div class="flex flex-col sm:flex-row items-start gap-4" data-hero-anim="cta">
              <a href="#demo" class="btn-primary text-base px-8 py-4">
                Demander ma démo personnalisée
                <svg class="w-4 h-4 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a href="#comparatif" class="btn-secondary text-base px-8 py-4">Voir le comparatif</a>
            </div>
          </div>

          <!-- Mock Kanban visuel -->
          <div class="relative hidden lg:block" data-hero-anim="visual">
            <div class="absolute -inset-4 bg-gradient-to-br from-alliance-blue/20 to-transparent rounded-3xl blur-2xl"></div>
            <div class="relative rounded-2xl border border-white/10 bg-alliance-dark-2/80 backdrop-blur-sm shadow-2xl overflow-hidden">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                  </div>
                  <span class="text-xs text-white/40 font-mono">pilotai.app</span>
                </div>
                <div class="grid grid-cols-3 gap-3">
                  <div class="space-y-2">
                    <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">À faire</p>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10">
                      <p class="text-xs text-white/80 font-medium mb-1">Préparer devis Martin</p>
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-alliance-blue"></span>
                        <span class="text-[10px] text-white/40">David · Ven</span>
                      </div>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10">
                      <p class="text-xs text-white/80 font-medium mb-1">Réviser maquettes</p>
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-alliance-blue"></span>
                        <span class="text-[10px] text-white/40">David</span>
                      </div>
                    </div>
                  </div>
                  <div class="space-y-2">
                    <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">En cours</p>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10">
                      <p class="text-xs text-white/80 font-medium mb-1">Audit RGPD clinique</p>
                      <div class="flex items-center gap-1.5">
                        <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 0h10.5a2.25 2.25 0 012.25 2.25v6.75a2.25 2.25 0 01-2.25 2.25H6.75a2.25 2.25 0 01-2.25-2.25v-6.75a2.25 2.25 0 012.25-2.25z"/></svg>
                        <span class="text-[10px] text-amber-400/80">Confidentiel</span>
                      </div>
                    </div>
                  </div>
                  <div class="space-y-2">
                    <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">En retard</p>
                    <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30">
                      <p class="text-xs text-white/80 font-medium mb-1">Convocation formation</p>
                      <div class="flex items-center gap-1.5">
                        <span class="text-[10px] text-red-400 font-bold">🔴 Retard</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mt-5">
                  <div class="flex items-center justify-between text-xs text-white/50 mb-1.5">
                    <span>Progression projet</span>
                    <span class="font-semibold text-white/70">62%</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/10 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-alliance-blue to-sky-400" style="width: 62%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLÈME -->
    <section id="probleme" class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12" data-reveal>
          <p class="text-red-400 text-sm font-bold uppercase tracking-widest mb-3">Le problème</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4">
            Asana, Monday, ClickUp : vos données partent aux US
          </h2>
          <p class="text-white/60 text-lg max-w-2xl mx-auto">
            Les outils de gestion de projet envoient vos tâches, vos réunions et vos données métier
            vers des serveurs américains. L'IA qu'ils proposent est une boîte noire.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          <div class="relief-panel relief-1 p-6 text-center" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
            </div>
            <h3 class="font-semibold text-white mb-2">Fuite de données</h3>
            <p class="text-sm text-white/60">Vos tâches, commentaires et réunions transitent par des serveurs US. Sous-traitants à déclarer dans chaque DPA.</p>
          </div>
          <div class="relief-panel relief-1 p-6 text-center" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-semibold text-white mb-2">IA boîte noire</h3>
            <p class="text-sm text-white/60">Vous ne savez pas quel modèle IA traite vos données, ni où elles vont après. Pas de contrôle sur la sensibilité.</p>
          </div>
          <div class="relief-panel relief-1 p-6 text-center" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.375c0 .621-.504 1.125-1.125 1.125h-1.5A1.125 1.125 0 019 18.375V15"/></svg>
            </div>
            <h3 class="font-semibold text-white mb-2">Pas faits pour l'oral</h3>
            <p class="text-sm text-white/60">Aucun outil ne capte vos réunions ou ne vous laisse dicter vos tâches en marchant. Tout est manuel.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SOLUTION -->
    <section id="solution" class="py-16 px-4 sm:px-6 lg:px-8 bg-alliance-dark-2">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12" data-reveal>
          <p class="text-alliance-blue text-sm font-bold uppercase tracking-widest mb-3">La solution</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4">
            Trois piliers qui changent tout
          </h2>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          <div class="relief-panel relief-2 p-8" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">IA souveraine</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              Un modèle IA local (Ollama) tourne sur votre serveur par défaut. Vos données confidentielles
              ne quittent jamais votre infrastructure. L'IA externe (Gemini) n'est utilisée qu'avec votre
              consentement explicite, pour les flux non sensibles.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Modèle local Ollama par défaut</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Routage par niveau de sensibilité</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Données en UE (Supabase Francfort)</li>
            </ul>
          </div>

          <div class="relief-panel relief-2 p-8" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.375c0 .621-.504 1.125-1.125 1.125h-1.5A1.125 1.125 0 019 18.375V15m6.75-6V4.875c0-.621-.504-1.125-1.125-1.125H8.25c-.621 0-1.125.504-1.125 1.125V9m6.75 0H8.25"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">Ingestion des réunions</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              Vos transcriptions Notta sont automatiquement ingérées. PilotAI extrait les next steps
              et les transforme en tâches assignées et datées. Fini le copier-coller manuel.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Intégration Notta native</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Extraction automatique des next steps</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Ingestion Gmail → tâches aussi</li>
            </ul>
          </div>

          <div class="relief-panel relief-2 p-8" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.375c0 .621-.504 1.125-1.125 1.125h-1.5A1.125 1.125 0 019 18.375V15m6.75-6V4.875c0-.621-.504-1.125-1.125-1.125H8.25c-.621 0-1.125.504-1.125 1.125V9m6.75 0H8.25"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">Pilotage vocal</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              Dictée de tâches en marchant via la PWA ou Telegram. L'IA locale comprend l'intention,
              crée la tâche, l'assigne et la date. Push matinal automatisé à 8h00.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> PWA installable (zéro install)</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Bot Telegram bidirectionnel</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Brief matinal auto (résumé du jour)</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DÉMO -->
    <section id="demo" class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-alliance-blue text-sm font-bold uppercase tracking-widest mb-3" data-reveal>Démo</p>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4" data-reveal>
          Voyez PilotAI en action
        </h2>
        <p class="text-white/60 text-lg mb-10 max-w-2xl mx-auto" data-reveal>
          La vidéo démo arrive en septembre. En attendant, demandez votre démo personnalisée :
          on regarde ensemble comment PilotAI s'adapte à votre entreprise.
        </p>

        <div class="relief-panel relief-2 p-8 sm:p-12 mb-10" data-reveal>
          <div class="w-20 h-20 rounded-full bg-alliance-blue/20 flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 00-.57.338l-.001.002-.002.004-.004.007-.006.011-.018.032-.042.064a23.76 23.76 0 01-.502.784c-.36.528-.853 1.176-1.418 1.632a8.345 8.345 0 01-2.86 1.63 8.187 8.187 0 01-3.338.293 8.357 8.357 0 01-3.236-1.108 8.322 8.322 0 01-2.526-2.275 8.36 8.36 0 01-1.562-3.257 8.343 8.343 0 01-.213-3.473 8.36 8.36 0 011.254-3.272 8.346 8.346 0 012.59-2.552 8.343 8.343 0 013.37-1.275 8.36 8.36 0 013.473.214 8.353 8.353 0 013.03 1.65 8.357 8.357 0 011.93 2.803c.034.078.066.157.097.236l.018.044.004.01.001.003.001.002a.375.375 0 00.57.338z"/>
            </svg>
          </div>
          <p class="text-white/70 text-lg mb-2">Vidéo démo à venir</p>
          <p class="text-white/40 text-sm mb-6">Disponible en septembre 2026</p>
        </div>

        <div class="relief-panel relief-2 p-8 max-w-xl mx-auto" data-reveal>
          <h3 class="font-display text-xl font-bold text-white mb-3">Recevoir ma démo personnalisée</h3>
          <p class="text-white/60 text-sm mb-6">Laissez votre email, on vous contacte pour une démo de 30 min adaptée à votre métier.</p>
          <form class="flex flex-col sm:flex-row gap-3" action="https://formspree.io/f/placeholder" method="POST">
            <input
              type="email"
              name="email"
              placeholder="votre@email.com"
              required
              class="flex-1 px-4 py-3 rounded-lg bg-white/10 border border-white/15 text-white placeholder-white/40 focus:outline-none focus:border-alliance-blue transition"
            />
            <button type="submit" class="btn-primary px-6 py-3 whitespace-nowrap">
              Recevoir ma démo
            </button>
          </form>
          <p class="text-xs text-white/40 mt-4">Vos données ne sont jamais partagées. RGPD respecté.</p>
        </div>
      </div>
    </section>

    <!-- COMPARATIF -->
    <section id="comparatif" class="py-16 px-4 sm:px-6 lg:px-8 bg-alliance-dark-2">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12" data-reveal>
          <p class="text-alliance-blue text-sm font-bold uppercase tracking-widest mb-3">Comparatif</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4">
            PilotAI vs les autres
          </h2>
        </div>

        <div class="relief-panel relief-2 overflow-hidden" data-reveal>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/10">
                <th class="text-left p-4 text-white/60 font-medium">Critère</th>
                <th class="text-center p-4 text-alliance-blue font-bold">PilotAI</th>
                <th class="text-center p-4 text-white/40 font-medium">Asana</th>
                <th class="text-center p-4 text-white/40 font-medium">Monday</th>
                <th class="text-center p-4 text-white/40 font-medium">ClickUp</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr>
                <td class="p-4 text-white/70">Souveraineté des données (UE)</td>
                <td class="text-center p-4 text-green-400">✓ Supabase UE</td>
                <td class="text-center p-4 text-red-400">✗ Serveurs US</td>
                <td class="text-center p-4 text-red-400">✗ Serveurs US</td>
                <td class="text-center p-4 text-red-400">✗ Serveurs US</td>
              </tr>
              <tr>
                <td class="p-4 text-white/70">IA locale (modèle sur votre serveur)</td>
                <td class="text-center p-4 text-green-400">✓ Ollama</td>
                <td class="text-center p-4 text-red-400">✗</td>
                <td class="text-center p-4 text-red-400">✗</td>
                <td class="text-center p-4 text-red-400">✗</td>
              </tr>
              <tr>
                <td class="p-4 text-white/70">Ingestion des réunions (Notta)</td>
                <td class="text-center p-4 text-green-400">✓ Natif</td>
                <td class="text-center p-4 text-red-400">✗</td>
                <td class="text-center p-4 text-red-400">✗</td>
                <td class="text-center p-4 text-red-400">✗</td>
              </tr>
              <tr>
                <td class="p-4 text-white/70">Pilotage vocal (PWA + Telegram)</td>
                <td class="text-center p-4 text-green-400">✓ Natif</td>
                <td class="text-center p-4 text-red-400">✗</td>
                <td class="text-center p-4 text-red-400">✗</td>
                <td class="text-center p-4 text-red-400">✗</td>
              </tr>
              <tr>

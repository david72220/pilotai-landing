---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "PilotAI",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, PWA, Telegram",
  "description": "SaaS de gestion de projet avec enregistrement automatique des réunions et compte rendu souverain : l'IA tourne en France, l'audio n'est jamais envoyé à un tiers et il est détruit après validation.",
  "offers": {
    "@type": "Offer",
    "price": "19.90",
    "priceCurrency": "EUR"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Alliance Digitale"
  }
};
---

<Layout
  title="PilotAI — Chaque réunion devient des actions, automatiquement"
  description="PilotAI enregistre vos réunions automatiquement et en tire un compte rendu souverain : transcription en France, audio détruit après validation, actions proposées à l'humain qui décide. Lancement octobre 2026."
  jsonLd={jsonLd}
>
  <Header />

  <main class="flex-1">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-alliance-dark-2 pt-24 pb-20 px-4 sm:px-6 lg:px-8">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-alliance-blue/10 via-transparent to-transparent"></div>
      <div class="relative max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-alliance-blue/30 bg-alliance-blue/10 text-alliance-blue text-xs font-semibold uppercase tracking-wider mb-6" data-hero-anim="badge">
              <span class="w-2 h-2 rounded-full bg-alliance-blue animate-pulse"></span>
              Lancement octobre 2026
            </div>

            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" data-hero-anim="title">
              <span class="hero-line">Chaque réunion devient des actions.</span><br class="hidden sm:block">
              <span class="gradient-text hero-line">Automatiquement.</span>
            </h1>

            <p class="text-lg sm:text-xl text-white/70 max-w-2xl mb-10 leading-relaxed" data-hero-anim="lead">
              Cliquez « Rejoindre la visio », PilotAI enregistre tout seul. La transcription tourne sur
              notre infrastructure en France — jamais chez un tiers — et l'audio est détruit dès que vous
              validez le compte rendu. Vous décidez de chaque action proposée, rien ne se crée sans vous.
            </p>

            <div class="flex flex-col sm:flex-row items-start gap-4" data-hero-anim="cta">
              <a href="#demo" class="btn-primary text-base px-8 py-4">
                Demander ma démo personnalisée
                <svg class="w-4 h-4 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a href="#comparatif" class="btn-secondary text-base px-8 py-4">Voir le comparatif</a>
            </div>
          </div>

          <!-- Mock Kanban visuel -->
          <div class="relative hidden lg:block" data-hero-anim="visual">
            <div class="absolute -inset-4 bg-gradient-to-br from-alliance-blue/20 to-transparent rounded-3xl blur-2xl"></div>
            <div class="relative rounded-2xl border border-white/10 bg-alliance-dark-2/80 backdrop-blur-sm shadow-2xl overflow-hidden">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                  </div>
                  <span class="text-xs text-white/40 font-mono">pilotai.app</span>
                </div>
                <div class="grid grid-cols-3 gap-3">
                  <div class="space-y-2">
                    <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">À faire</p>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10">
                      <p class="text-xs text-white/80 font-medium mb-1">Préparer devis Martin</p>
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-alliance-blue"></span>
                        <span class="text-[10px] text-white/40">David · Ven</span>
                      </div>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10">
                      <p class="text-xs text-white/80 font-medium mb-1">Réviser maquettes</p>
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-alliance-blue"></span>
                        <span class="text-[10px] text-white/40">David</span>
                      </div>
                    </div>
                  </div>
                  <div class="space-y-2">
                    <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">En cours</p>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10">
                      <p class="text-xs text-white/80 font-medium mb-1">Audit RGPD clinique</p>
                      <div class="flex items-center gap-1.5">
                        <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 0h10.5a2.25 2.25 0 012.25 2.25v6.75a2.25 2.25 0 01-2.25 2.25H6.75a2.25 2.25 0 01-2.25-2.25v-6.75a2.25 2.25 0 012.25-2.25z"/></svg>
                        <span class="text-[10px] text-amber-400/80">Confidentiel</span>
                      </div>
                    </div>
                  </div>
                  <div class="space-y-2">
                    <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">En retard</p>
                    <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30">
                      <p class="text-xs text-white/80 font-medium mb-1">Convocation formation</p>
                      <div class="flex items-center gap-1.5">
                        <span class="text-[10px] text-red-400 font-bold">🔴 Retard</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mt-5">
                  <div class="flex items-center justify-between text-xs text-white/50 mb-1.5">
                    <span>Progression projet</span>
                    <span class="font-semibold text-white/70">62%</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-white/10 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-alliance-blue to-sky-400" style="width: 62%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLÈME -->
    <section id="probleme" class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12" data-reveal>
          <p class="text-red-400 text-sm font-bold uppercase tracking-widest mb-3">Le problème</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4">
            Vos réunions se perdent — ou partent chez un tiers américain
          </h2>
          <p class="text-white/60 text-lg max-w-2xl mx-auto">
            Sans automatisme, l'enregistrement est oublié, les décisions ne ressortent que dans la tête
            de ceux qui étaient présents, et le seul outil qui pourrait aider envoie votre audio aux États-Unis.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          <div class="relief-panel relief-1 p-6 text-center" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
            </div>
            <h3 class="font-semibold text-white mb-2">On oublie d'enregistrer</h3>
            <p class="text-sm text-white/60">La réunion démarre, personne ne pense à lancer l'enregistrement. Le compte rendu, s'il existe, est fait de mémoire.</p>
          </div>
          <div class="relief-panel relief-1 p-6 text-center" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-semibold text-white mb-2">Les décisions se perdent</h3>
            <p class="text-sm text-white/60">Ce qui a été décidé reste dans la tête des participants. Personne ne le retranscrit en tâches, alors ça ne se fait pas.</p>
          </div>
          <div class="relief-panel relief-1 p-6 text-center" data-reveal>
            <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
            </div>
            <h3 class="font-semibold text-white mb-2">Vos réunions chez un tiers américain</h3>
            <p class="text-sm text-white/60">Les outils de transcription du marché exigent un bot participant et un abonnement IA par utilisateur, et envoient votre audio outre-Atlantique.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SOLUTION -->
    <section id="solution" class="py-16 px-4 sm:px-6 lg:px-8 bg-alliance-dark-2">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12" data-reveal>
          <p class="text-alliance-blue text-sm font-bold uppercase tracking-widest mb-3">La solution</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4">
            Un système d'enregistrement natif, pas un bot qui s'invite
          </h2>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          <div class="relief-panel relief-2 p-8 lg:col-span-3" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">Auto-enregistrement des réunions</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              Cliquez « Rejoindre la visio » : l'enregistrement démarre tout seul, aucun bot tiers à inviter.
              Une fenêtre flottante reste au premier plan — même en partage d'écran — avec la durée,
              « Fin de la réunion », « capter la visio » et « Prolonger 30 min » si ça déborde.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Démarrage automatique, aucun bot participant</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Fenêtre flottante toujours visible</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Audio découpé et envoyé au fil de l'eau — une coupure réseau ne perd que 30s</li>
            </ul>
          </div>

          <div class="relief-panel relief-2 p-8" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">CR souverain</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              La transcription tourne sur l'infrastructure Alliance Digitale, en France. L'audio ne part
              jamais chez un tiers — et il est détruit dès que vous validez le compte rendu.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Transcription IA en France</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Audio détruit après validation du CR</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Vous relisez et corrigez avant de valider</li>
            </ul>
          </div>

          <div class="relief-panel relief-2 p-8" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">De la parole aux actions</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              L'IA propose des tâches, réunions ou idées extraites du compte rendu, avec un pilote suggéré.
              Rien ne se crée automatiquement : vous validez, corrigez ou rejetez chaque proposition.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Extraction tâches / réunions / idées</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Pilote suggéré, jamais imposé</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Réservé à l'organisateur de la réunion</li>
            </ul>
          </div>

          <div class="relief-panel relief-2 p-8" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">Externes sans compte</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              Vos clients et fournisseurs sont invités par simple email : le créneau s'ajoute à leur agenda
              (fichier ICS), avec un lien pour répondre. Le compte rendu se partage en un clic, sans compte à créer.
            </p>
            <ul class="space-y-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Invitation par email, zéro compte requis</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Créneau ICS + lien RSVP</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> CR partageable en un clic</li>
            </ul>
          </div>

          <div class="relief-panel relief-2 p-8 lg:col-span-3" data-reveal>
            <div class="w-14 h-14 rounded-xl bg-alliance-blue/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-alliance-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.375c0 .621-.504 1.125-1.125 1.125h-1.5A1.125 1.125 0 019 18.375V15m6.75-6V4.875c0-.621-.504-1.125-1.125-1.125H8.25c-.621 0-1.125.504-1.125 1.125V9m6.75 0H8.25"/></svg>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-3">Le socle de gestion de projet</h3>
            <p class="text-white/60 text-sm leading-relaxed mb-4">
              Tout ce qu'il faut autour de la réunion : projets et arbres de tâches illimités, groupes par
              échéance colorés, assistant vocal (créer, terminer, reporter une tâche, même inviter un externe
              à la voix), notifications réglables par email, flux calendrier Google/Outlook, charge d'équipe,
              et un RGPD natif (export, effacement) sur une base multi-tenant cloisonnée par RLS.
            </p>
            <ul class="grid sm:grid-cols-2 gap-2 text-sm text-white/70">
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Assistant vocal, même pour inviter un externe</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Flux calendrier Google / Outlook</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Charge d'équipe par personne</li>
              <li class="flex items-center gap-2"><svg class="w-4 h-4 text-alliance-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> RGPD natif : export et effacement</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DÉMO -->
    <section id="demo" class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-alliance-blue text-sm font-bold uppercase tracking-widest mb-3" data-reveal>Démo</p>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4" data-reveal>
          Voyez PilotAI en action
        </h2>
        <p class="text-white/60 text-lg mb-10 max-w-2xl mx-auto" data-reveal>
          Une minute pour voir ce que PilotAI change au quotidien. Et si vous voulez aller
          plus loin, demandez votre démo personnalisée : on regarde ensemble comment
          PilotAI s'adapte à votre entreprise.
        </p>

        <div id="video" class="relief-panel relief-2 p-3 sm:p-4 mb-10 scroll-mt-24" data-reveal>
          <video
            controls
            preload="metadata"
